# Banco de dados
# Local (SQLite):
DATABASE_URL=sqlite:///banco.sqlite
# Produção (Railway PostgreSQL):
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# E-mail para reset de senha
# IMPORTANTE: Use "Senha de App" do Google, NÃO a senha normal da conta
# Como gerar: myaccount.google.com → Segurança → Verificação em 2 etapas → Senhas de app
EMAIL_REMETENTE=seu@gmail.com
EMAIL_SENHA_APP=xxxx xxxx xxxx xxxx
